<Window x:Class="ChudoObuvApp.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Товар" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" x:Name="TxtTitle" FontSize="24" FontWeight="Bold" Foreground="#70B2AF" Margin="0,0,0,20"/>

        <!-- Информация о товаре -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" x:Name="ImgProduct" Width="200" Height="200" Stretch="Uniform"/>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock x:Name="TxtProizvodstvo" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtCategoria" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtPrice" FontSize="24" FontWeight="Bold" Foreground="#70B2AF" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>

        <!-- Выбор размера и количества -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Размер:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Grid.Column="1" x:Name="CmbSize" Margin="0,0,20,0"/>

            <TextBlock Grid.Column="2" Text="Количество:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Grid.Column="3" x:Name="TxtQuantity" Text="1" Margin="0,0,20,0" Width="50"/>

            <Button Grid.Column="4" Content="Оформить заказ" Click="BtnOrder_Click" Background="#70B2AF" Foreground="White" FontWeight="Bold" Padding="10,5"/>
        </Grid>

        <!-- Кнопка назад -->
        <Button Grid.Row="3" Content="Назад" Click="BtnBack_Click" HorizontalAlignment="Left" Margin="0,20,0,0" Width="100"/>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="3" x:Name="TxtMessage" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>