<Window x:Class="ChudoObuvApp.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Заказы" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список заказов" FontSize="24" FontWeight="Bold" Foreground="#70B2AF" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="DgOrders" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                <DataGridTextColumn Header="Клиент (ФИО)" Binding="{Binding ClientName}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum, StringFormat=\{0:N0\} ₽}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Назад" Click="BtnBack_Click" Width="120" Margin="0,0,10,0"/>
            <Button Content="Состав заказа" Click="BtnDetails_Click" Width="140" Margin="0,0,10,0" Background="#70B2AF" Foreground="White"/>
            <Button Content="Удалить заказ" Click="BtnDelete_Click" Width="140" Background="#FF8080" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>